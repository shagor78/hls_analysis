# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OTT Migration & Backup Suite Configuration
OTT_ENV="production"
DATABASE_URL="sqlite:///./data/ott_migration.db"
SOURCE_DB_URL="sqlite:///./data/authorized_source_ott.db"
TARGET_DB_URL="sqlite:///./data/authorized_target_ott.db"

# Security & SSRF Controls
ALLOW_PRIVATE_NETWORKS="false"
URL_ALLOWLIST=""
AUDIT_LOG_PATH="./logs/audit.log"

# Scanner & Validator Reliability Settings
DEFAULT_TIMEOUT_MS="8000"
DEFAULT_MAX_RETRIES="3"
DEFAULT_CONCURRENCY="5"
DEFAULT_RATE_LIMIT_RPS="10"

